{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "functions": {
    "api/build/repo.ts": { "maxDuration": 300 },
    "api/build/start.ts": { "maxDuration": 90 },
    "api/build/finish.ts": { "maxDuration": 120 },
    "api/og.ts": { "maxDuration": 30, "includeFiles": "fonts/**" }
  },
  "redirects": [
    { "source": "/orgs/:org([A-Za-z0-9][A-Za-z0-9-]{0,38})/:rest*", "destination": "/:org", "permanent": false },
    { "source": "/:owner((?!(?:api|v|s|u|fonts|local-store|explore|events|readme|about|404|index)(?:/|$))[A-Za-z0-9][A-Za-z0-9-]{0,38})/:repo([A-Za-z0-9._-]{1,96})\\.git", "destination": "/:owner/:repo", "permanent": false },
    { "source": "/:owner((?!(?:api|v|s|u|fonts|local-store|explore|events|readme|about|404|index)(?:/|$))[A-Za-z0-9][A-Za-z0-9-]{0,38})/:repo([A-Za-z0-9._-]{1,100})/:rest+", "destination": "/:owner/:repo", "permanent": false }
  ],
  "rewrites": [
    { "source": "/api/auth/:op(login|callback|logout)", "destination": "/api/account?op=:op" },
    { "source": "/api/:op(me|settings)", "destination": "/api/account?op=:op" },
    { "source": "/api/:op(city|gallery|stars|live|pulse|version)", "destination": "/api/site?op=:op" },
    { "source": "/:owner((?!(?:api|v|s|u|fonts|local-store|explore|events|readme|about|404|index)(?:/|$))[A-Za-z0-9][A-Za-z0-9-]{0,38})", "destination": "/api/page?t=:owner" },
    { "source": "/:owner((?!(?:api|v|s|u|fonts|local-store|explore|events|readme|about|404|index)(?:/|$))[A-Za-z0-9][A-Za-z0-9-]{0,38})/:repo([A-Za-z0-9._-]{1,100})", "destination": "/api/page?t=:owner/:repo" }
  ],
  "headers": [
    { "source": "/v/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] },
    { "source": "/s/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=300, s-maxage=86400, stale-while-revalidate=86400" }] },
    { "source": "/s/f/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    }
  ]
}
